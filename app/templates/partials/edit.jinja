{#=====================================================
  template
=====================================================#}

<div class="task_edit" hx-target="this" hx-swap="outerHTML">
  <form hx-post="/tasks/{{task.id}}">
    <p>{{task.id}}</p>
    <label for="name">
     <input type="text" name="name" id="name" value="{{task.name}}">
    </label>
    <label for="priority">
      <input type="range" name="priority" id="priority" value="{{task.priority}}" min="0" max="5">
    </label>
    <button>Submit</button>
    <button hx-delete="/tasks/{{task.id}}">Delete</button>
  </form>
</div>
